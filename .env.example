# Server only. Never prefix these values with NEXT_PUBLIC_.
GEMINI_API_KEY=
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# At least 12 characters. npm run setup generates a local password.
BROADCAST_PASSWORD=
# At least 32 characters. npm run setup generates a random signing secret.
AUTH_SECRET=

# Production: set to your public HTTPS origin, without a trailing slash.
# Local development can leave this blank.
APP_URL=
